version: int
input: string
buffer: int
workers: int
idle_flush: time.Duration
max_line: int
stages: []stage
stage aggregate:
  by: []string
  metrics: []string
  top: int
  max_keys: int
stage dedup:
  by: []string
  window: time.Duration
  max_keys: int
stage filter:
  where: []string
stage limit:
  n: int64
stage map:
  ops: []string
stage reconcile:
  correlate_by: string
  window: time.Duration
  max_keys: int
  max_decisions: int
  on_timeout: string
  on_duplicate: string
stage triage:
  default_decision: string
  rules: []
    - name: string
      where: []string
      decision: string
      reason: string
      requires_ack: bool
stage window:
  size: time.Duration
  lateness: time.Duration
  by: []string
  metrics: []string
  max_open: int
  max_keys: int
